# ============================================================
# 复制为 .env 后填入真实密钥；切勿提交 .env 进 git
# 一键生成强密钥：
#   openssl rand -base64 32
# ============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_pwd
MYSQL_DATABASE=nacos_config
MYSQL_USER=nacos
MYSQL_PASSWORD=CHANGE_ME_nacos_db_pwd

# ---- Nacos 鉴权（必须改）----
NACOS_AUTH_ENABLE=true
# 必须 ≥32 位 Base64，命令：openssl rand -base64 32
NACOS_AUTH_TOKEN=CHANGE_ME_base64_token_at_least_32_bytes
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME_random_value

# ---- JVM（按机器规格调）----
JVM_XMS=512m
JVM_XMX=1g
JVM_XMN=256m
